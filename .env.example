# Set these in Vercel for Production, Preview and Development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Never put a Supabase secret/service-role key in a NEXT_PUBLIC_ variable.

# Keep false until legal review, retention rules and administrator access are ready.
NEXT_PUBLIC_IDENTITY_VERIFICATION_ENABLED=false
